# Copiar a .env y completar. El .env NO se commitea.

# ---- Modelo de lenguaje ----
# Proveedor: google_genai | anthropic | openai | openrouter | ollama | fake
# "fake" no llama a ninguna API: sirve para probar el pipeline sin clave.
# openrouter y ollama (cloud) usan la API compatible con OpenAI; el modelo va en LLM_MODEL
# (p. ej. google/gemma-4-31b-it:free en OpenRouter, gemma4:31b en Ollama).
# Todo esto se puede pisar por corrida con --proveedor / --modelo / --modelo-vision.
LLM_PROVIDER=fake
# Modelo por defecto del proveedor elegido (vacío = default de config.py)
# google_genai: gemini-2.5-flash | anthropic: claude-opus-5-5 (o claude-haiku-5-5 para OCR barato) | openai: gpt-5
# ollama (cloud, plan gratuito): gpt-oss:120b para texto + LLM_MODEL_VISION=gemma4:31b para páginas escaneadas
LLM_MODEL=
# Modelo para transcribir páginas escaneadas (visión). Vacío = el mismo que LLM_MODEL.
LLM_MODEL_VISION=
# Cuotas vistas el 26/10/2026: AI Studio gratuito = 20 pedidos/día en gemini-2.5-flash (no alcanza para un
# reglamento de 60 páginas); Ollama cloud gratuito = 1 pedido a la vez. Para corridas completas hace falta
# una clave paga (Claude Haiku 5.5 fue la mejor relación calidad/costo en docs/evaluaciones/).

GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=

# ---- OCR ----
# Caracteres de capa de texto por página a partir de los cuales la página se considera "con texto"
OCR_UMBRAL_TEXTO_CHARS=200
# Confianza media de Tesseract (0-100) a partir de la cual el escaneo se considera "bueno"
OCR_UMBRAL_CONFIANZA=75
# Páginas de muestra que el clasificador analiza con Tesseract para decidir
OCR_PAGINAS_MUESTRA=3
# Páginas que Tesseract transcribe por debajo de la confianza se escalan a visión (true/false)
OCR_ESCALAR_A_VISION=true
# DPI para rasterizar páginas
OCR_DPI=200

# ---- Bases de datos (valores de docker-compose) ----
POSTGRES_USER=consorcio
POSTGRES_PASSWORD=consorcio
POSTGRES_DB=consorcio
POSTGRES_URL=postgresql+psycopg://consorcio:consorcio@postgres:5432/consorcio

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=consorcio123

# ---- Trazabilidad ----
# Vacío = sin MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=consorcio-ingesta

# ---- Consorcios ----
# Base (consorcio) que usan la CLI y la evaluación si no se pasa --consorcio. Cada chat de Telegram usa la suya.
CONSORCIO_POR_DEFECTO=mercedes-274

# ---- Canales ----
# Bot de Telegram (crearlo con @BotFather). Se levanta con `make bot`.
TELEGRAM_BOT_TOKEN=
# Ids de chat separados por coma a los que responde (los muestra /start). Vacío = responde a cualquiera: solo para probar.
TELEGRAM_CHATS_PERMITIDOS=

# ---- Salidas ----
DIR_PROCESADOS=datos/procesados
# PDFs recibidos por Telegram antes de ingestarse
DIR_ENTRADA=datos/entrada
